#!/bin/bash
#
# Runs Detekt over the project before a commit is created.
#
# `detekt` reformats what its formatting ruleset can fix and fails on what it cannot, so a single
# invocation is both the formatter and the quality gate. Files it rewrote are staged again, because
# a reformatted file that stays unstaged would commit the unformatted version.
set -uo pipefail

STAGED_KOTLIN_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(kt|kts)$')

if [ -z "$STAGED_KOTLIN_FILES" ]; then
    echo "No staged Kotlin files: skipping Detekt."
    exit 0
fi

echo "Staged Kotlin files:"
echo "$STAGED_KOTLIN_FILES" | sed 's/^/  - /'

if [ -f "./gradlew" ]; then
    GRADLE_CMD="./gradlew"
else
    GRADLE_CMD="gradle"
fi

echo "Running Detekt…"
if ! $GRADLE_CMD detekt --daemon; then
    echo "Detekt failed. Fix the reported violations before committing." >&2
    exit 1
fi

# Re-stage the files Detekt reformatted; untouched files are simply staged again as they were.
echo "$STAGED_KOTLIN_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

echo "Detekt passed."
exit 0
