#!/bin/bash
# Pre-commit hook to execute Detekt auto-formatting and static checks on modified Kotlin files.

# Filter staged Kotlin files (Added, Copied, Modified, Renamed)
STAGED_KOTLIN_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(kt|kts)$')

if [ -z "$STAGED_KOTLIN_FILES" ]; then
    echo "ℹ️  No modified Kotlin files detected in staged index. Skipping Detekt formatting."
    exit 0
fi

echo "🔍 Modified Kotlin files detected:"
echo "$STAGED_KOTLIN_FILES" | sed 's/^/  - /'

if [ -f "./gradlew" ]; then
    GRADLE_CMD="./gradlew"
else
    GRADLE_CMD="gradle"
fi

echo "✨ Running Detekt auto-formatting on modified files..."
$GRADLE_CMD detektFormat --daemon

FORMAT_EXIT_CODE=$?
if [ $FORMAT_EXIT_CODE -ne 0 ]; then
    echo "❌ Detekt auto-formatting task failed with code $FORMAT_EXIT_CODE."
    exit 1
fi

# Re-stage formatted files that were previously staged
echo "$STAGED_KOTLIN_FILES" | while IFS= read -r file; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

echo "🛡️  Running Detekt static analysis validation..."
$GRADLE_CMD detekt --daemon

CHECK_EXIT_CODE=$?
if [ $CHECK_EXIT_CODE -ne 0 ]; then
    echo "❌ Detekt static analysis failed. Please fix reported violations before committing."
    exit 1
fi

echo "✅ Detekt auto-formatting and quality checks successfully applied to modified files!"
exit 0
