    <string name="format_help_timestamp">Timestamp tokens: yyyy, yy, MMM, MM, dd, HH, mm, ss, SSS, XXX, epochMillis, epochSeconds. Everything else is matched literally.</string>
    <string name="format_help_template">Structure placeholders: {timestamp} (required), {level}, {tag}, {message}, and {any} to skip a varying part such as a counter or a thread id ({any} may be repeated).\nSpaces match any run of whitespace; punctuation such as &lt; &gt; ~ | is matched literally, and {{ }} stand for literal braces.</string>
    <string name="format_help_json">A key may be a dotted path such as log.level. An empty box means the log carries no such component; only the timestamp key is required.</string>
    <string name="format_help_delimited">The separator is one character, or \\t for a tab. A column written #2 is the third one; any other text is a header name and reads only when the first line names the columns.</string>

