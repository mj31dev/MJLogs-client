    <!-- A dateless log running past midnight, where both candidate days fit; neither is a default. -->
    <string name="start_day_title">Two days fit this file</string>
    <string name="start_day_explanation">Its records carry the time of day but no date, and the times run past midnight, so the file covers two days. Neither the file nor the moment it was last written says which two — and read under the wrong day, every record sits a day away from the screencast.</string>
    <string name="start_day_question">Which day does it start on?</string>
    <string name="start_day_confirm">Use this day</string>
    <string name="start_day_skip">Skip file</string>

