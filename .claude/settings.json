{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/detekt-stop.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(./gradlew detekt*)",
      "Bash(./gradlew test*)",
      "Bash(./gradlew verifySourceLayout*)",
      "Bash(./gradlew :domain:desktopTest*)",
      "Bash(./gradlew :data:desktopTest*)",
      "Bash(./gradlew :app:desktopTest*)",
      "Bash(./gradlew :app:desktopRun*)",
      "Bash(./gradlew tasks*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "ask": [
      "Bash(*git checkout*)",
      "Bash(*git switch*)",
      "Bash(*git restore*)",
      "Bash(*git merge*)",
      "Bash(*git cherry-pick*)",
      "Bash(*git branch -D*)",
      "Bash(*git branch -d*)",
      "Bash(*curl * -X POST*)",
      "Bash(*curl * --data*)",
      "Bash(*curl * -d *)",
      "Bash(*chmod 777*)"
    ],
    "deny": [
      "Bash(*git commit*)",
      "Bash(*git push*)",
      "Bash(*git stash*)",
      "Bash(*git reset*)",
      "Bash(*git rebase*)",
      "Bash(*git clean*)",
      "Bash(*rm -rf .git*)",
      "Bash(*rm -rf /*)",
      "Bash(*rm -rf ~/*)",
      "Bash(*rm -rf ../*)",
      "Bash(* ~/.ssh*)",
      "Bash(* ~/.aws*)",
      "Bash(*sudo*)",
      "Bash(*su *)",
      "Bash(*killall*)",
      "Bash(*python*)",
      "Bash(*python3*)"
    ]
  }
}
