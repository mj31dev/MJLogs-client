{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "project": {
    "name": "MJLogs",
    "language": "kotlin",
    "package": "dev.mj31.logger.client"
  },
  "autoFormat": {
    "enabled": true,
    "onSave": true,
    "onEdit": true,
    "rules": [
      {
        "pattern": "**/*.{kt,kts}",
        "command": "./gradlew detektFormat"
      }
    ]
  },
  "hooks": {
    "preCommit": "./.githooks/pre-commit",
    "postEdit": "./gradlew detektFormat"
  },
  "qualityGates": {
    "staticAnalysis": "./gradlew detekt",
    "testSuite": "./gradlew test"
  },
  "permissions": {
    "defaultMode": "accept",
    "allow": [
      "*"
    ],
    "ask": [
      "Bash(*git checkout*)",
      "Bash(*git switch*)",
      "Bash(*git restore*)",
      "Bash(*git merge*)",
      "Bash(*git cherry-pick*)",
      "Bash(*git branch -D*)",
      "Bash(*git branch -d*)",
      "Bash(*curl * -X POST*)",
      "Bash(*curl * --data*)",
      "Bash(*curl * -d *)",
      "Bash(*chmod 777*)"
    ],
    "deny": [
      "Bash(*git commit*)",
      "Bash(*git push*)",
      "Bash(*git stash*)",
      "Bash(*git reset*)",
      "Bash(*git rebase*)",
      "Bash(*git clean*)",
      "Bash(*rm -rf .git*)",
      "Bash(*rm -rf /*)",
      "Bash(*rm -rf ~/*)",
      "Bash(*rm -rf ../*)",
      "Bash(* ~/.ssh*)",
      "Bash(* ~/.aws*)",
      "Bash(*sudo*)",
      "Bash(*su *)",
      "Bash(*killall*)",
      "Bash(*python*)",
      "Bash(*python3*)"
    ]
  }
}
